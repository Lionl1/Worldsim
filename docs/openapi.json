{
  "openapi": "3.0.3",
  "info": { "title": "worldsim API", "version": "0.3.0", "description": "Simulations, training environments and Mission Lab. If the server runs with a token, pass Authorization: Bearer <token>. Open without a token: only / and /healthz." },
  "components": { "securitySchemes": { "bearer": { "type": "http", "scheme": "bearer" } } },
  "security": [{ "bearer": [] }],
  "paths": {
    "/healthz": { "get": { "summary": "Server liveness", "security": [], "responses": { "200": { "description": "ok" } } } },
    "/api/version": { "get": { "summary": "Version and server settings", "responses": { "200": { "description": "ok" } } } },
    "/api/openapi.json": { "get": { "summary": "This description", "responses": { "200": { "description": "ok" } } } },
    "/api/presets": { "get": { "summary": "Presets of worlds, stars, galaxies", "responses": { "200": { "description": "ok" } } } },
    "/api/world": { "get": { "summary": "World parameters", "responses": { "200": { "description": "ok" } } } },
    "/api/climate": { "get": { "summary": "Seasonal climate model", "responses": { "200": { "description": "ok" } } } },
    "/api/throw": { "get": { "summary": "Ballistics", "responses": { "200": { "description": "ok" } } } },
    "/api/system": { "get": { "summary": "Star system generator", "responses": { "200": { "description": "ok" } } } },
    "/api/nbody/new": { "get": { "summary": "New N-body session", "responses": { "200": { "description": "ok" } } } },
    "/api/nbody/step": { "get": { "summary": "N-body step", "responses": { "200": { "description": "ok" } } } },
    "/api/galaxy/new": { "get": { "summary": "New galaxy", "responses": { "200": { "description": "ok" } } } },
    "/api/galaxy/step": { "get": { "summary": "Galaxy step, binary response", "responses": { "200": { "description": "float32" } } } },
    "/api/galaxy/rotation": { "get": { "summary": "Rotation curve", "responses": { "200": { "description": "ok" } } } },
    "/api/cosmo/new": { "get": { "summary": "New cosmological simulation", "responses": { "200": { "description": "ok" } } } },
    "/api/cosmo/step": { "get": { "summary": "Cosmology step, binary response", "responses": { "200": { "description": "float32" } } } },
    "/api/cosmo/power": { "get": { "summary": "Power spectrum", "responses": { "200": { "description": "ok" } } } },
    "/api/cosmo/background": { "get": { "summary": "Background expansion", "responses": { "200": { "description": "ok" } } } },
    "/api/env/tasks": { "get": { "summary": "Environment tasks", "responses": { "200": { "description": "ok" } } } },
    "/api/env/schema": { "get": { "summary": "Parameter registry: names, units, ranges, default values", "responses": { "200": { "description": "ok" } } } },
    "/api/env/make": { "get": { "summary": "New environment", "parameters": [
      { "name": "task", "in": "query", "schema": { "type": "string", "enum": ["lander", "drone", "rover"] } },
      { "name": "physics", "in": "query", "schema": { "type": "string" } },
      { "name": "worlds", "in": "query", "schema": { "type": "string" }, "description": "List of worlds of the form moon,mars:earth:moon" },
      { "name": "params", "in": "query", "schema": { "type": "string" }, "description": "Registry parameters of the form isp=320,gust=2" },
      { "name": "seed", "in": "query", "schema": { "type": "integer" } } ], "responses": { "200": { "description": "ok" }, "400": { "description": "invalid parameters" } } } },
    "/api/env/reset": { "get": { "summary": "New episode", "responses": { "200": { "description": "ok" } } } },
    "/api/env/step": { "get": { "summary": "Environment step", "parameters": [
      { "name": "id", "in": "query", "required": true, "schema": { "type": "integer" } },
      { "name": "action", "in": "query", "schema": { "type": "string" } },
      { "name": "mode", "in": "query", "schema": { "type": "string", "enum": ["auto", "random"] } },
      { "name": "repeat", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } },
      { "name": "traj", "in": "query", "schema": { "type": "integer", "enum": [0, 1] } } ], "responses": { "200": { "description": "ok" } } } },
    "/api/env/state": { "get": { "summary": "True state and hidden parameters", "responses": { "200": { "description": "ok" } } } },
    "/api/env/terrain": { "get": { "summary": "Height map", "responses": { "200": { "description": "ok" } } } },
    "/api/env/camera": { "get": { "summary": "Camera: depth in JSON or RGB in binary form", "responses": { "200": { "description": "ok" } } } },
    "/api/env/list": { "get": { "summary": "Active environments", "responses": { "200": { "description": "ok" } } } },
    "/api/env/fork": { "get": { "summary": "Environment copy for branching", "responses": { "200": { "description": "ok" } } } },
    "/api/env/close": { "get": { "summary": "Close the environment", "responses": { "200": { "description": "ok" } } } },
    "/api/mission/example": { "get": { "summary": "Example mission description", "responses": { "200": { "description": "ok" } } } },
    "/api/mission/run": { "post": { "summary": "Mission calculation that waits for the result", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } }, "responses": { "200": { "description": "report" }, "400": { "description": "error in the description" } } } },
    "/api/jobs": { "get": { "summary": "Background jobs", "responses": { "200": { "description": "ok" } } } },
    "/api/jobs/mission": { "post": { "summary": "Run a mission in the background", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } }, "responses": { "200": { "description": "id jobs" }, "429": { "description": "too many jobs" } } } },
    "/api/jobs/{id}": { "get": { "summary": "Job state and progress", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "ok" } } } },
    "/api/jobs/{id}/cancel": { "post": { "summary": "Cancel a job", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "ok" } } } },
    "/api/runs": { "get": { "summary": "Saved runs", "responses": { "200": { "description": "ok" } } } },
    "/api/runs/compare": { "get": { "summary": "Comparison of two runs", "parameters": [{ "name": "a", "in": "query", "required": true, "schema": { "type": "string" } }, { "name": "b", "in": "query", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "ok" } } } },
    "/api/runs/{id}": { "get": { "summary": "Run report", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "ok" } } } },
    "/api/blackhole/props": { "get": { "summary": "Black hole quantities", "responses": { "200": { "description": "ok" } } } },
    "/api/blackhole/render": { "get": { "summary": "Render, binary RGB", "responses": { "200": { "description": "rgb" } } } },
    "/api/lab/{topic}": { "get": { "summary": "Experiment: tunnel, levels, hydrogen, sod, dam, chapman, nozzle, crater, collide, ocean", "parameters": [{ "name": "topic", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "ok" } } } },
    "/api/validate": { "get": { "summary": "Law checks", "responses": { "200": { "description": "ok" } } } },
    "/data/stars.json": { "get": { "summary": "Star catalog", "responses": { "200": { "description": "ok" }, "404": { "description": "catalog not downloaded" } } } },
    "/data/exoplanets.json": { "get": { "summary": "Exoplanet catalog", "responses": { "200": { "description": "ok" }, "404": { "description": "catalog not downloaded" } } } }
  }
}
