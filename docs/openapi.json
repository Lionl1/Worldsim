{
  "openapi": "3.0.3",
  "info": { "title": "worldsim API", "version": "0.3.0", "description": "Симуляции, среды для обучения и Mission Lab. Если сервер запущен с токеном, передавайте Authorization: Bearer <токен>. Открыты без токена только / и /healthz." },
  "components": { "securitySchemes": { "bearer": { "type": "http", "scheme": "bearer" } } },
  "security": [{ "bearer": [] }],
  "paths": {
    "/healthz": { "get": { "summary": "Живость сервера", "security": [], "responses": { "200": { "description": "ok" } } } },
    "/api/version": { "get": { "summary": "Версия и настройки сервера", "responses": { "200": { "description": "ok" } } } },
    "/api/openapi.json": { "get": { "summary": "Это описание", "responses": { "200": { "description": "ok" } } } },
    "/api/presets": { "get": { "summary": "Пресеты миров, звёзд, галактик", "responses": { "200": { "description": "ok" } } } },
    "/api/world": { "get": { "summary": "Параметры мира", "responses": { "200": { "description": "ok" } } } },
    "/api/climate": { "get": { "summary": "Сезонная модель климата", "responses": { "200": { "description": "ok" } } } },
    "/api/throw": { "get": { "summary": "Баллистика", "responses": { "200": { "description": "ok" } } } },
    "/api/system": { "get": { "summary": "Генератор звёздной системы", "responses": { "200": { "description": "ok" } } } },
    "/api/nbody/new": { "get": { "summary": "Новая сессия N тел", "responses": { "200": { "description": "ok" } } } },
    "/api/nbody/step": { "get": { "summary": "Шаг N тел", "responses": { "200": { "description": "ok" } } } },
    "/api/galaxy/new": { "get": { "summary": "Новая галактика", "responses": { "200": { "description": "ok" } } } },
    "/api/galaxy/step": { "get": { "summary": "Шаг галактики, бинарный ответ", "responses": { "200": { "description": "float32" } } } },
    "/api/galaxy/rotation": { "get": { "summary": "Кривая вращения", "responses": { "200": { "description": "ok" } } } },
    "/api/cosmo/new": { "get": { "summary": "Новая космологическая симуляция", "responses": { "200": { "description": "ok" } } } },
    "/api/cosmo/step": { "get": { "summary": "Шаг космологии, бинарный ответ", "responses": { "200": { "description": "float32" } } } },
    "/api/cosmo/power": { "get": { "summary": "Спектр мощности", "responses": { "200": { "description": "ok" } } } },
    "/api/cosmo/background": { "get": { "summary": "Фоновое расширение", "responses": { "200": { "description": "ok" } } } },
    "/api/env/tasks": { "get": { "summary": "Задачи сред", "responses": { "200": { "description": "ok" } } } },
    "/api/env/schema": { "get": { "summary": "Реестр параметров: имена, единицы, диапазоны, значения по умолчанию", "responses": { "200": { "description": "ok" } } } },
    "/api/env/make": { "get": { "summary": "Новая среда", "parameters": [
      { "name": "task", "in": "query", "schema": { "type": "string", "enum": ["lander", "drone", "rover"] } },
      { "name": "physics", "in": "query", "schema": { "type": "string" } },
      { "name": "worlds", "in": "query", "schema": { "type": "string" }, "description": "Список миров вида moon,mars:earth:moon" },
      { "name": "params", "in": "query", "schema": { "type": "string" }, "description": "Параметры реестра вида isp=320,gust=2" },
      { "name": "seed", "in": "query", "schema": { "type": "integer" } } ], "responses": { "200": { "description": "ok" }, "400": { "description": "неверные параметры" } } } },
    "/api/env/reset": { "get": { "summary": "Новый эпизод", "responses": { "200": { "description": "ok" } } } },
    "/api/env/step": { "get": { "summary": "Шаг среды", "parameters": [
      { "name": "id", "in": "query", "required": true, "schema": { "type": "integer" } },
      { "name": "action", "in": "query", "schema": { "type": "string" } },
      { "name": "mode", "in": "query", "schema": { "type": "string", "enum": ["auto", "random"] } },
      { "name": "repeat", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } },
      { "name": "traj", "in": "query", "schema": { "type": "integer", "enum": [0, 1] } } ], "responses": { "200": { "description": "ok" } } } },
    "/api/env/state": { "get": { "summary": "Истинное состояние и скрытые параметры", "responses": { "200": { "description": "ok" } } } },
    "/api/env/terrain": { "get": { "summary": "Карта высот", "responses": { "200": { "description": "ok" } } } },
    "/api/env/camera": { "get": { "summary": "Камера: глубина в JSON или RGB в бинарном виде", "responses": { "200": { "description": "ok" } } } },
    "/api/env/list": { "get": { "summary": "Активные среды", "responses": { "200": { "description": "ok" } } } },
    "/api/env/fork": { "get": { "summary": "Копия среды для ветвления", "responses": { "200": { "description": "ok" } } } },
    "/api/env/close": { "get": { "summary": "Закрыть среду", "responses": { "200": { "description": "ok" } } } },
    "/api/mission/example": { "get": { "summary": "Пример описания миссии", "responses": { "200": { "description": "ok" } } } },
    "/api/mission/run": { "post": { "summary": "Расчёт миссии с ожиданием результата", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } }, "responses": { "200": { "description": "отчёт" }, "400": { "description": "ошибка в описании" } } } },
    "/api/jobs": { "get": { "summary": "Фоновые задачи", "responses": { "200": { "description": "ok" } } } },
    "/api/jobs/mission": { "post": { "summary": "Запустить миссию в фоне", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } }, "responses": { "200": { "description": "id задачи" }, "429": { "description": "слишком много задач" } } } },
    "/api/jobs/{id}": { "get": { "summary": "Состояние задачи и прогресс", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "ok" } } } },
    "/api/jobs/{id}/cancel": { "post": { "summary": "Отменить задачу", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "ok" } } } },
    "/api/runs": { "get": { "summary": "Сохранённые запуски", "responses": { "200": { "description": "ok" } } } },
    "/api/runs/compare": { "get": { "summary": "Сравнение двух запусков", "parameters": [{ "name": "a", "in": "query", "required": true, "schema": { "type": "string" } }, { "name": "b", "in": "query", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "ok" } } } },
    "/api/runs/{id}": { "get": { "summary": "Отчёт запуска", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "ok" } } } },
    "/api/blackhole/props": { "get": { "summary": "Величины чёрной дыры", "responses": { "200": { "description": "ok" } } } },
    "/api/blackhole/render": { "get": { "summary": "Рендер, бинарный RGB", "responses": { "200": { "description": "rgb" } } } },
    "/api/lab/{topic}": { "get": { "summary": "Опыт: tunnel, levels, hydrogen, sod, dam, chapman, nozzle, crater, collide, ocean", "parameters": [{ "name": "topic", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "ok" } } } },
    "/api/validate": { "get": { "summary": "Проверка законов", "responses": { "200": { "description": "ok" } } } },
    "/data/stars.json": { "get": { "summary": "Каталог звёзд", "responses": { "200": { "description": "ok" }, "404": { "description": "каталог не скачан" } } } },
    "/data/exoplanets.json": { "get": { "summary": "Каталог экзопланет", "responses": { "200": { "description": "ok" }, "404": { "description": "каталог не скачан" } } } }
  }
}
